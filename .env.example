MONGODB_URI=
MONGODB_DBNAME=

# Basic Auth для админских эндпоинтов (/users)
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# JWT access token
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=

# JWT refresh token
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# Rate limiting (5 запросов / 10 сек на auth-эндпоинтах)
THROTTLE_ENABLED=
THROTTLE_TTL_MS=
THROTTLE_LIMIT=

# Время жизни кода подтверждения email (мс, по умолчанию 1 ч)
EMAIL_CONFIRMATION_CODE_TTL_MS=

# Время жизни кода восстановления пароля (мс, по умолчанию 1 ч)
PASSWORD_RECOVERY_CODE_TTL_MS=

# Почта (Gmail через OAuth2)
EMAIL_ADDRESS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
